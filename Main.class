public class Main {
    public static void main(String[] args) {
        System.out.println(MathUtil.isPrime(9));
        System.out.println(MathUtil.gcd(9, 12));
        System.out.println(MathUtil.lcm(9, 12));
        System.out.println(MathUtil.fibonacci(6));
        System.out.println(MathUtil.factorial(6));
        var mathUtil = new MathUtil();
        System.out.println(mathUtil.isPerfect(6));
        System.out.println(mathUtil.sumOfDigits(1269));
        System.out.println(mathUtil.reverseNumber(1269));
        System.out.println(mathUtil.nextPrime(17));
    }
}
